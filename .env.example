# Environment Variables Configuration Example
# Copy this file to .env and fill in your actual API keys

# MapBox API Key - Get from https://account.mapbox.com/
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here

# WeatherAPI Key - Get from https://www.weatherapi.com/
WEATHER_API_KEY=your_weather_api_key_here

# OpenWeatherMap API Key - Get from https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# OpenRouteService API Key - Get from https://openrouteservice.org/dev/#/signup
OPENROUTE_SERVICE_API_KEY=your_openroute_service_api_key_here

# ============================================================
# ROS BRIDGE CONFIGURATION (JETSON AGX XAVIER)
# ============================================================
# 
# For LOCAL TESTING (rosbridge on same machine):
#   ROS_WEBSOCKET_URL=ws://localhost:9090
#
# For JETSON AGX XAVIER (mobil/vehicle):
#   ROS_WEBSOCKET_URL=ws://<JETSON_IP>:9090
#   Example: ROS_WEBSOCKET_URL=ws://192.168.1.100:9090
#
# Make sure rosbridge_server is running on Jetson:
#   roslaunch rosbridge_server rosbridge_websocket.launch port:=9090
#
ROS_WEBSOCKET_URL=ws://localhost:9090

# ============================================================
# ZED CAMERA STREAMING (JETSON AGX XAVIER)
# ============================================================
#
# ZED Camera streams MJPEG video over HTTP from Jetson.
# Much lighter than ROS image topics!
#
# SETUP ON JETSON:
#   1. Install dependencies:
#      pip install flask opencv-python
#      (ZED SDK should already be installed)
#
#   2. Run the streaming server:
#      cd deployment/scripts
#      python3 zed_mjpeg_server.py --port 8080 --resolution VGA
#
#   3. Options:
#      --resolution: VGA (672x376), HD720, HD1080, HD2K
#      --fps: Target FPS (default: 30)
#      --quality: JPEG quality 1-100 (default: 70)
#
# BANDWIDTH ESTIMATES:
#   VGA @ 30fps:    ~2-3 Mbps
#   HD720 @ 30fps:  ~5-8 Mbps
#   HD1080 @ 30fps: ~10-15 Mbps
#
# For LOCAL TESTING (webcam simulation):
#   ZED_CAMERA_URL=http://localhost:8080/video_feed
#
# For JETSON:
#   ZED_CAMERA_URL=http://<JETSON_IP>:8080/video_feed
#
ZED_CAMERA_URL=http://192.168.1.100:8080/video_feed

# Legacy camera stream (deprecated, use ZED_CAMERA_URL instead)
CAMERA_STREAM_URL=your_camera_stream_url_here